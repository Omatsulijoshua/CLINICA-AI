# DATABASE
POSTGRES_DB=clinica_db
POSTGRES_USER=clinica_user
POSTGRES_PASSWORD=SecurePassword123!
POSTGRES_PORT=5432

# REDIS
REDIS_PORT=6379

# QDRANT (VECTOR DB)
QDRANT_PORT_HTTP=6333
QDRANT_PORT_GRPC=6334

# MINIO (OBJECT STORAGE)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadminpassword
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET_NAME=clinica-files

# BACKEND CONFIG
BACKEND_PORT=5000
JWT_SECRET=SuperSecretClinicaAIKey1234567890EncryptionKey!
JWT_ISSUER=ClinicaAI
JWT_AUDIENCE=ClinicaAIClients

# AI ENGINE CONFIG
# If left empty, Clinica AI will automatically fall back to its internal local rules-based clinical reasoning engine.
OPENAI_API_KEY=

# FRONTEND CONFIG
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:5000
